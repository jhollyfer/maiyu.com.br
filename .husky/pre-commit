# The commit gate, per app and filtered by folder (`_standards/tooling.md` §6): `check` and the
# unit suite only for the app the commit touches. Touching `shared/` tests both consumers, because
# it is their contract. Functional and E2E bring up database and browser and run in the session,
# before the PR (DECISIONS.md #298): in the hook they would make the commit slow enough for
# `--no-verify`.
staged=$(git diff --cached --name-only)

# git exports GIT_DIR to the hook; with it, a `git` run inside an app (the `git ls-files` of
# `pattern:check`, which drops these variables itself too, DECISIONS.md #809) takes the current folder as the root and lists the whole repository as if it
# were the app's. Holds in a worktree too (DECISIONS.md #311).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

touches() {
  printf '%s\n' "$staged" | grep -q "^$1/"
}

# A frontend-only project has no backend/: an app that is not in the workspace is skipped, not run.
has() {
  [ -f "$1/package.json" ]
}

if has shared && touches shared; then
  pnpm --filter ./shared check && pnpm --filter ./shared test:unit || exit 1
fi
if has backend && { touches backend || touches shared; }; then
  pnpm --filter ./backend check && pnpm --filter ./backend test:unit || exit 1
fi
# A frontend still on the legacy app (migration by phases, DECISIONS.md #786) is declared in the manifest
# the sync writes (`"frontend": "legado"`, set by `sync --frontend=legado`): its `check` is not the kit's
# and has errors that predate the migration, so it would block every backend commit. It is skipped, never
# silently: one line says so, and `sync --check` keeps listing `frontend-legado:` until `--frontend=kit`.
legacy_frontend() {
  grep -q '"frontend": *"legado"' .maiyu/kit-extension-points.json 2>/dev/null
}

# backend too: the frontend tsconfig includes the backend for the Tuyau registry, so a backend type
# change can break the frontend typecheck.
if has frontend && { touches frontend || touches shared || touches backend; }; then
  if legacy_frontend; then
    echo "pre-commit: frontend ainda legado (manifesto .maiyu): check do frontend pulado"
  else
    pnpm --filter ./frontend check && pnpm --filter ./frontend test:unit || exit 1
  fi
fi
