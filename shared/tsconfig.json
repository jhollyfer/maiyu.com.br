{
  // `shared/` profile of `_standards/tooling.md` §3: no preset, `NodeNext`, and relative
  // imports with the `.js` extension. What compiles under `NodeNext` also compiles under
  // `bundler`, so the same source serves the backend (Node) and the frontend (Vite).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts", "*.ts"]
}
