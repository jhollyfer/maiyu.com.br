{
  // Os tipos do servidor gerado pelo Nitro. Sem isto, `nitro/*` e as globais do
  // runtime não resolvem - passo documentado em `examples/vite-nitro-plugin`.
  "extends": "nitro/tsconfig",

  // Os dois `*.config.js` ficam de fora: o `eslint.config.js` do kit os ignora, e o
  // `eslint-plugin-jsx-a11y` não traz tipos, então incluí-lo aqui reprovaria o `typecheck`.
  "include": ["**/*.ts", "**/*.tsx", "scripts/**/*.mjs"],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    // Um alias só, e é o que o campo `imports` do package.json declara. Com os
    // dois, cada arquivo escolhia um e o `@/` voltava sozinho toda vez que o
    // shadcn gerava um componente.
    "paths": {
      "#/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    // Desligada por ordem do TanStack Start: ligada, ela pode vazar o bundle de servidor no do
    // cliente (_doc-lib/tanstack-start.md#build-from-scratch). É a única flag do piso que o
    // perfil frontend desliga (_standards/tooling.md §3).
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true
  }
}
