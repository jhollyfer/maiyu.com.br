FROM node:24-alpine

WORKDIR /app

# curl para healthcheck
RUN apk add --no-cache curl

# Copia o .output pronto, que vem do artifact. O contexto do build é a raiz do
# repositório (main-docker-frontend.yml), então o caminho começa em frontend/.
COPY frontend/.output/ ./.output/

# Usuario nao-root
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nitro && \
    chown -R nitro:nodejs /app/.output

USER nitro

# O `curl` instalado lá em cima existia sem consumidor. O orquestrador precisa
# saber se o Nitro subiu, e não só se o processo está de pé: um SSR que morreu
# no boot deixa o container vivo e a página em branco.
#
# `/health-check` e não `/`: a home renderiza o site inteiro (fontes, imagens e
# as três línguas), e medir por ela seria medir a página, não o processo.
# `/health-check` não sai do processo (`_standards/architecture.md` §7).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/health-check || exit 1

EXPOSE 3000
ENV PORT=3000

CMD ["node", ".output/server/index.mjs"]
