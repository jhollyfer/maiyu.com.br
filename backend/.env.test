#--------------------------------------------------------------------
# Node
#--------------------------------------------------------------------
# The same zone as every environment (DECISIONS.md #393), so a date the suite
# writes reads back the same as in production.
TZ=America/Eirunepe

#--------------------------------------------------------------------
# Database
#--------------------------------------------------------------------
# A database SEPARATE from the development one: the suite runs `truncate()`
# between tests, and without this line it would wipe the development data. The
# runner refuses a name without the `_test` suffix or a host outside the machine
# (`tests/database-guard.ts`). Create it once with:
#   docker compose exec database createdb -U maiyu maiyu_test
DATABASE_URL=postgres://maiyu:maiyu@localhost:5440/maiyu_test

#--------------------------------------------------------------------
# Storage
#--------------------------------------------------------------------
# Presigned multipart upload: the suite talks to the docker-compose MinIO, the
# same code path as production. Bucket SEPARATE from the development one, for
# the same reason as DATABASE_URL above. The bucket is created by the
# `minio-setup` service.
#
# The ceiling is 16 GiB here, deliberately above the dev one: the suite needs to
# declare sizes that the development ceiling would refuse. Nothing is
# transferred: the test binary is a few KB, and the large size travels only as
# metadata.
UPLOAD_MAX_SIZE=17179869184

STORAGE_KEY=maiyu
STORAGE_SECRET=maiyu-secret
STORAGE_BUCKET=maiyu-test
STORAGE_ENDPOINT=http://localhost:9016
STORAGE_FORCE_PATH_STYLE=true

#--------------------------------------------------------------------
# CORS
#--------------------------------------------------------------------
# The origin barrier applies the list in every environment; the first origin is
# the one `tests/bootstrap.ts` sends on every write, and the spec that measures
# the refusal sets its own `Origin`.
CORS_ORIGINS=http://localhost:3000

#--------------------------------------------------------------------
# Seeding
#--------------------------------------------------------------------
# The suite runs `db().seed()` on every test, and the owner seed is switched on by
# the password: the pair goes together, and it is the account of
# `tests/http-fixtures.ts`. `SEED_DEMO_PASSWORD` stays out on purpose, so the
# suite starts from an empty database.
SEED_OWNER_EMAIL=administrator@mail.com
SEED_OWNER_PASSWORD=Administrator1!
