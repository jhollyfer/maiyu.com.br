{
  "name": "@maiyu/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts",
    "./registry": "./.adonisjs/client/registry/index.ts"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "build:deps": "pnpm --filter \"{.}^...\" build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "openapi:generate": "node ace openapi:generate",
    "openapi:check": "node ace openapi:generate --check --strict",
    "pattern:check": "node --import @poppinss/ts-exec scripts/pattern-check.ts",
    "authz:check": "node --import @poppinss/ts-exec scripts/authz-check.ts",
    "validators:check": "node --import @poppinss/ts-exec scripts/validators-check.ts",
    "depcruise": "depcruise app --config scripts/depcruise.config.ts",
    "di:check": "node ace di:check",
    "check": "pnpm build:deps && pnpm format:check && pnpm lint && pnpm typecheck && pnpm openapi:check && pnpm pattern:check && pnpm authz:check && pnpm validators:check && pnpm test:unit",
    "test:unit": "node ace test unit",
    "test:e2e": "node ace test functional"
  },
  "imports": {
    "#features/*": "./app/features/*.js",
    "#validators/*": "./app/validators/*.js",
    "#core/*": "./app/core/*.js",
    "#domain/*": "./app/domain/*.js",
    "#repositories/*": "./app/repositories/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#services/*": "./app/services/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#guards/*": "./app/guards/*.js",
    "#providers/*": "./providers/*.js",
    "#commands/*": "./commands/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/bouncer": "^4.0.1",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/i18n": "^3.0.1",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/shield": "^9.0.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@maiyu/shared": "workspace:*",
    "@tuyau/core": "^1.3.0",
    "@vinejs/vine": "^4.4.0",
    "argon2": "^0.45.2",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "proxy-addr": "^2.0.8",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.2",
    "@types/json-schema": "^7.0.15",
    "@types/luxon": "^3.7.6",
    "@types/node": "~26.6.6",
    "@types/proxy-addr": "^2.0.3",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.0",
    "hot-hook": "^1.1.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "youch": "^4.1.1"
  },
  "hotHook": {
    "boundaries": [
      "./app/features/**/*.controller.ts",
      "./app/middleware/*.ts"
    ]
  }
}
