# Backend environment model of the house (`_standards/backend.md` section 6.2).
# Same keys, same order, same blocks in every project; only the example values
# are the project's own (port, database name, bucket). `sync-to-project.mjs --check`
# compares the key list and fails on an extra, a missing or a misplaced key.
# Projects on the same stack have the same key count and the same names: only the
# `optional` blocks of a resource the project does not have (mail, queue, jwt) may
# be left out, whole. A feature is switched on by its key having a value (the
# seeders below), never by a separate flag. A key the catalog does not have is not
# added here: it goes to the upstream first.

#--------------------------------------------------------------------
# Node
#--------------------------------------------------------------------
NODE_ENV=development
PORT=3333
# In a container use `0.0.0.0`: `localhost` only accepts connections from inside
# the container itself, so the host proxy never reaches it.
HOST=localhost
# Process time zone. `UTC` in every environment: when absent, Node inherits the
# host time zone and the same query answers different dates depending on the
# machine. Converting to the reader's time zone is the presentation layer's job.
TZ=UTC

#--------------------------------------------------------------------
# App
#--------------------------------------------------------------------
LOG_LEVEL=info
# Cipher key. Required, no default, never committed: generate it with `node ace generate:key`.
APP_KEY=
APP_SERVER_URL=http://${HOST}:${PORT}

# Public origin of the web app. Only when the app and the API live on different
# sites: it decides the cookie `sameSite`.
# APP_CLIENT_URL=https://app.example.com

# Reverse proxies whose `X-Forwarded-For` is trusted: addresses, CIDR ranges and
# the words `loopback`, `linklocal`, `uniquelocal` and `cloudflare` (Cloudflare's
# published edge ranges, kept in `#core/trusted-proxies`), comma separated. When
# absent only `loopback` applies: right with no proxy in front, and behind a
# reverse proxy (Coolify's Traefik) **it must be declared**, otherwise
# `request.ip()` returns the proxy IP for everyone and the per-IP limits
# (sign-in, refresh) become one global bucket. Never `true`: the client would
# forge the header and pick the limit key. Use the proxy network, not the whole
# internet. With Cloudflare in front of Traefik: `uniquelocal,cloudflare`.
# TRUSTED_PROXIES=uniquelocal

#--------------------------------------------------------------------
# Session
#--------------------------------------------------------------------
# The `Domain` of the session cookies. Empty in development, and that is right:
# cookies ignore the port, so `localhost:3333` and `localhost:3000` already share
# the same domain.
#
# In production, with the app and the API on different sibling hosts, it is
# **required**, and the schema does not demand it because empty is the right
# value in development. Without it the cookie is host-only on the API host, and
# the frontend SSR never receives it. The value is the smallest domain that
# covers both hosts.
# COOKIE_DOMAIN=.example.com

#--------------------------------------------------------------------
# CORS
#--------------------------------------------------------------------
# Browser origins allowed to call this API, comma separated, in every environment:
# the origin barrier refuses a write from an origin outside the list, development
# included (DECISIONS.md #353). Empty in production stops the boot. `*` is not an
# option: the API uses cookies, and the protocol refuses the wildcard when the
# request carries credentials. Below, the frontend of `pnpm dev`.
CORS_ORIGINS=http://localhost:3000

#--------------------------------------------------------------------
# Database
#--------------------------------------------------------------------
# 5433 and not 5432: the default port is often taken by another Postgres on the
# same machine, and the project's `docker-compose.yml` publishes on 5433.
DATABASE_URL=postgres://app:app@localhost:5433/app
# TLS on the connection. **Absent means TLS off**: the connection goes out in
# clear text. It depends on where the database is, not on the environment: a
# database on the application's private network usually does not speak TLS
# (leave it absent or `false`); a managed database, outside it, requires `true`.
# DATABASE_SSL=false

#--------------------------------------------------------------------
# Storage
#--------------------------------------------------------------------
# Upload is presigned multipart: the binary goes from the browser straight to the
# bucket and never crosses this application. Multipart is an S3 API, so the
# destination is an S3-compatible bucket in every environment: MinIO in dev and
# in tests, and in production whatever STORAGE_ENDPOINT points to.
#
# Per-file ceiling, in bytes. Required: without it the application does not
# start. How much fits in an upload is the operator's decision, and a default in
# the code would be a ceiling nobody chose. Below, 1 GiB.
UPLOAD_MAX_SIZE=1073741824

# Root of the local MinIO (`docker compose up -d`). Only the setup and the
# console use it; the application signs in with the minimal-scope user below.
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=

# Credential, bucket and endpoint are required. Below, the local MinIO with the
# API on 9002 for the same reason as the database port.
STORAGE_KEY=app
STORAGE_SECRET=
STORAGE_BUCKET=app
STORAGE_ENDPOINT=http://localhost:9002
# MinIO only serves `endpoint/bucket/key`. In production (R2, S3, Spaces), remove.
STORAGE_FORCE_PATH_STYLE=true
# The bucket is **private**: nothing in it is served by a public URL, and every
# read goes through a short-lived signed URL. The production bucket needs CORS
# open to the frontend origin, with PUT in the methods and `ETag` in
# ExposeHeaders: without the exposed ETag the client cannot confirm the parts
# and no multipart upload completes.

#--------------------------------------------------------------------
# Seeding
#--------------------------------------------------------------------
# Each seed is switched on by its key having a value, in any environment: empty
# skips that seed (one log line) and the rest of `node ace db:seed` runs.
# Reference data the app needs to work (neighborhoods, categories) has no key and
# always runs. No password lives in the code: it would be a credential known to
# anyone who read the repository.
#
# The first administrator. With the password and without the e-mail the seeder
# stops: the pair goes together.
SEED_OWNER_EMAIL=administrator@example.com
SEED_OWNER_PASSWORD=
# The demo: one account per role (`<role>@example.com`) sharing this password,
# plus the sample content that shows each profile.
SEED_DEMO_PASSWORD=

# --- optional: mail ---
#--------------------------------------------------------------------
# Mail
#--------------------------------------------------------------------
# Only where the application sends e-mail. No default: the application stops
# instead of sending from an address nobody chose.
MAIL_FROM=
SMTP_HOST=
# Port of the SMTP server: 587 with STARTTLS, 465 with implicit TLS.
SMTP_PORT=587
# Credentials of an authenticated relay (Resend, SES, Postmark). Empty for a
# relay that does not ask for login, such as the local Mailpit in development.
SMTP_USERNAME=
SMTP_PASSWORD=
# --- end optional ---

# --- optional: queue ---
#--------------------------------------------------------------------
# Queue
#--------------------------------------------------------------------
# Cache, queue and rate limit store. When absent the application uses the database.
REDIS_URL=
# --- end optional ---

# --- optional: jwt ---
#--------------------------------------------------------------------
# JWT
#--------------------------------------------------------------------
# Fastify with RS256 only. Private signing key, never in the CI YAML: `secrets.*` only.
JWT_PRIVATE_KEY=
# --- end optional ---

#--------------------------------------------------------------------
# Docker Compose
#--------------------------------------------------------------------
# Read only by `docker-compose.yml`, never by the application.
DB_PORT=5433
STORAGE_PORT=9002
STORAGE_CONSOLE_PORT=9003
