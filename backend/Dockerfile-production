# Production image of the API, built from the workspace root
# (`_standards/tooling.md` §8.2): `docker build -f backend/Dockerfile-production .`.
# From the root the build sees the single `pnpm-lock.yaml` and the `pnpm-workspace.yaml`.
#
# Multi-stage, and the build happens in here - not on the CI runner. The reason is that
# the image is multi-architecture (amd64 and arm64) and the project has a dependency with a
# native binary (`@swc/core`): a `node_modules` compiled on the amd64 runner does not
# run on the arm64 variant. Building per stage, each architecture installs its own
# binary.
#
# The base is pinned by digest and Dependabot updates it: a moving tag changes what
# was audited without a single commit.

FROM node:24-alpine@sha256:a34ab6d7f6f4813f4d0c5469d74685604b962fbdbf5793a7bc7b4998ecb867c8 AS builder

WORKDIR /app

# pnpm by npm, as in the academy (DECISIONS.md #395), and not by Corepack: pnpm 12 changed
# the package layout and the Corepack bundled with Node 24 looks for the binary at the old
# path and fails with MODULE_NOT_FOUND. On first use pnpm switches to the
# `devEngines.packageManager` version of the root, so the version lives in one place
# (_doc-lib/pnpm.md#installation, https://pnpm.io/installation).
RUN npm install -g pnpm

# Manifests before the code, so the install stays cached while only the
# code changes. `pnpm-workspace.yaml` carries `allowBuilds`: without it the install
# decides on its own what to compile, or stops and asks (_doc-lib/pnpm.md#docker).
# The frontend manifest comes in because the single lockfile describes every package and
# `--frozen-lockfile` checks all of them; the bracket makes it a wildcard, which BuildKit
# lets match nothing when the project has no `frontend/`.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/
COPY frontend/package.jso[n] frontend/
COPY shared/package.json shared/
# The commit hook has no use inside the image, and `prepare` must not install it
# (_doc-lib/husky.md#how-to.html, https://typicode.github.io/husky/how-to.html).
# ENV and not inline because `pnpm deploy` below installs again; the builder
# stage does not reach the final image.
ENV HUSKY=0
RUN pnpm --filter "{./backend}..." install --frozen-lockfile

COPY shared/ shared/
COPY backend/ backend/

# `node ace build` boots the application (`bin/console.ts` imports `#start/env` in
# `app.booting`), so the validation of `start/env.ts` runs during the build and
# every required key of the schema (`_standards/backend.md` section 6.2) must be
# present. The values are placeholders that only satisfy the schema. They stay
# on the `RUN` line and never in ENV: ENV becomes image metadata, so a
# credential-shaped value there (APP_KEY, DATABASE_URL, STORAGE_SECRET) would
# ship with the image, and buildkit warns about it. In production the platform
# injects the real variables. A key the project adds to `start/env.ts` as
# required goes here too, or the build stops on the schema. The filter with
# `...` first builds what the backend uses from the workspace, in topological
# order (_doc-lib/pnpm.md#filtering).
RUN NODE_ENV=development \
    PORT=3333 \
    HOST=0.0.0.0 \
    LOG_LEVEL=info \
    APP_KEY=build-time-placeholder-not-used-at-runtime \
    APP_SERVER_URL=http://localhost:3333 \
    TRUSTED_PROXIES=loopback \
    CORS_ORIGINS=http://localhost:3000 \
    DATABASE_URL=postgres://build:build@localhost:5432/build \
    DRIVE_DISK=s3 \
    UPLOAD_MAX_SIZE=1073741824 \
    STORAGE_KEY=build \
    STORAGE_SECRET=build \
    STORAGE_BUCKET=build \
    STORAGE_ENDPOINT=http://localhost:9000 \
    pnpm --filter "{./backend}..." run build

# Only the production dependencies, with whatever comes from the workspace inside, in an
# isolated folder (_doc-lib/pnpm.md#cli/deploy, https://pnpm.io/cli/deploy). Only its
# `node_modules` is used: the files the deploy copies follow `files`, `.npmignore` and
# `.gitignore`, and `build/` is gitignored, so the compiled app comes straight from the
# `backend/build/` of this stage and never depends on what the deploy copied.
RUN pnpm --filter ./backend --prod deploy /out


FROM node:24-alpine@sha256:a34ab6d7f6f4813f4d0c5469d74685604b962fbdbf5793a7bc7b4998ecb867c8

WORKDIR /app

# `curl` for the healthcheck, as in the academy image (`DECISIONS.md` #395).
RUN apk add --no-cache curl

# `build/` brings `bin/`, `config/`, `database/` and the `openapi.json` declared in
# `metaFiles` - the `GET /openapi.json` route reads that file from disk. The
# `node_modules` comes from the deploy: production only, no assembler, eslint or typescript.
COPY --from=builder --chown=node:node /app/backend/build ./
COPY --from=builder --chown=node:node /out/node_modules ./node_modules

# The `node` image already ships the `node` user (uid 1000). There is no upload
# directory to fix permissions on: every file goes to the S3-compatible bucket.
USER node

EXPOSE 3333

ENV NODE_ENV=production \
    PORT=3333 \
    HOST=0.0.0.0

# The orchestrator must know the app answers, not only that the process is alive. The
# route is `/health-check` and never `/`, and it touches no database. The image
# healthcheck is the one Coolify uses (`tooling.md` section 8.2, `DECISIONS.md` #328, #395).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:3333/health-check || exit 1

# No ENTRYPOINT: migrations do not run on container start. What migrates is the
# platform's deploy command (`node ace migration:run --force`; on Coolify the
# Post-deployment command, `tooling.md` §8.2), so that
# starting a replica is not the same event as changing the schema.
CMD ["node", "bin/server.js"]
